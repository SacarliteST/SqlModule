          "rows": [["1", "Ноутбук"], ["3", "Стол"]]
        }
      }
    },
    {
      "id": "94000000-0000-0000-0000-000000000018",
      "topicId": "93000000-0000-0000-0000-000000000005",
      "targetDatabaseId": "92000000-0000-0000-0000-000000000001",
      "referenceQueryId": "95000000-0000-0000-0000-000000000018",
      "name": "Клиенты с оплаченными заказами",
      "text": "Выведите id и имя клиентов, у которых есть хотя бы один заказ со статусом paid. Сортируйте по id.",
      "learningGoal": "Проверить существование связанных строк через EXISTS.",
      "difficultyLevel": 3,
      "publicationStatus": "Published",
      "hints": ["Свяжите подзапрос с текущим клиентом по customer_id."],
      "referenceQuery": {
        "sqlText": "SELECT c.id, c.full_name FROM customers c WHERE EXISTS (SELECT 1 FROM orders o WHERE o.customer_id = c.id AND o.status = 'paid') ORDER BY c.id;",
        "strictColumnOrder": true,
        "strictRowOrder": true,
        "expectedResult": {
          "columns": ["id", "full_name"],
          "rows": [["1", "Анна"]]
        }
      }
    },
    {
      "id": "94000000-0000-0000-0000-000000000019",
      "topicId": "93000000-0000-0000-0000-000000000005",
      "targetDatabaseId": "92000000-0000-0000-0000-000000000001",
      "referenceQueryId": "95000000-0000-0000-0000-000000000019",
      "name": "Товары без заказов",
      "text": "Выведите id и название товаров, которые ни разу не встречаются в order_items. Сортируйте по id.",
      "learningGoal": "Найти отсутствие связанных строк через NOT EXISTS.",
      "difficultyLevel": 3,
      "publicationStatus": "Published",
      "hints": ["В коррелированном подзапросе сравните product_id с id товара."],
      "referenceQuery": {
        "sqlText": "SELECT p.id, p.name FROM products p WHERE NOT EXISTS (SELECT 1 FROM order_items oi WHERE oi.product_id = p.id) ORDER BY p.id;",
        "strictColumnOrder": true,
        "strictRowOrder": true,
        "expectedResult": {
          "columns": ["id", "name"],
          "rows": [["6", "Кресло"]]
        }
      }
