    {
      "id": "94000000-0000-0000-0000-000000000020",
      "topicId": "93000000-0000-0000-0000-000000000005",
      "targetDatabaseId": "92000000-0000-0000-0000-000000000001",
      "referenceQueryId": "95000000-0000-0000-0000-000000000020",
      "name": "Крупные заказы через CTE",
      "text": "Через CTE вычислите суммы заказов и выведите order_id и order_total для сумм больше 10000. Сортируйте по order_total по убыванию.",
      "learningGoal": "Разбить запрос на понятные этапы с помощью WITH.",
      "difficultyLevel": 3,
      "publicationStatus": "Published",
      "hints": ["В CTE сгруппируйте order_items, затем фильтруйте готовые суммы."],
      "referenceQuery": {
        "sqlText": "WITH order_totals AS (SELECT order_id, SUM(quantity * unit_price) AS order_total FROM order_items GROUP BY order_id) SELECT order_id, order_total FROM order_totals WHERE order_total > 10000 ORDER BY order_total DESC;",
        "strictColumnOrder": true,
        "strictRowOrder": true,
        "expectedResult": {
          "columns": ["order_id", "order_total"],
          "rows": [["1", "93000.00"], ["2", "25000.00"]]
        }
      }
    }
