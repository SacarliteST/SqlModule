  "tasks": [
    {
      "id": "94000000-0000-0000-0000-000000000001",
      "topicId": "93000000-0000-0000-0000-000000000001",
      "targetDatabaseId": "92000000-0000-0000-0000-000000000001",
      "referenceQueryId": "95000000-0000-0000-0000-000000000001",
      "name": "Список клиентов",
      "text": "Выведите идентификатор и имя каждого клиента. Сохраните порядок по id.",
      "learningGoal": "Выбрать нужные столбцы и упорядочить строки.",
      "difficultyLevel": 1,
      "publicationStatus": "Published",
      "hints": ["Укажите столбцы после SELECT.", "Используйте ORDER BY id."],
      "referenceQuery": {
        "sqlText": "SELECT id, full_name FROM customers ORDER BY id;",
        "strictColumnOrder": true,
        "strictRowOrder": true,
        "expectedResult": {
          "columns": ["id", "full_name"],
          "rows": [["1", "Анна"], ["2", "Борис"], ["3", "Вера"], ["4", "Глеб"]]
        }
      }
    },
    {
      "id": "94000000-0000-0000-0000-000000000002",
      "topicId": "93000000-0000-0000-0000-000000000001",
      "targetDatabaseId": "92000000-0000-0000-0000-000000000001",
      "referenceQueryId": "95000000-0000-0000-0000-000000000002",
      "name": "Каталог товаров",
      "text": "Выведите id, название и цену всех товаров в порядке id.",
      "learningGoal": "Прочитать несколько столбцов одной таблицы.",
      "difficultyLevel": 1,
      "publicationStatus": "Published",
      "hints": ["Данные находятся в products."],
      "referenceQuery": {
        "sqlText": "SELECT id, name, price FROM products ORDER BY id;",
        "strictColumnOrder": true,
        "strictRowOrder": true,
        "expectedResult": {
          "columns": ["id", "name", "price"],
          "rows": [["1", "Ноутбук", "90000.00"], ["2", "Мышь", "1500.00"], ["3", "Стол", "25000.00"], ["4", "Книга", "1200.00"], ["5", "Лампа", "4000.00"], ["6", "Кресло", "18000.00"]]
        }
      }
    },
    {
      "id": "94000000-0000-0000-0000-000000000003",
      "topicId": "93000000-0000-0000-0000-000000000001",
      "targetDatabaseId": "92000000-0000-0000-0000-000000000001",
      "referenceQueryId": "95000000-0000-0000-0000-000000000003",
      "name": "Псевдоним столбца",
      "text": "Выведите имя клиента как customer_name и его город. Отсортируйте по id клиента.",
      "learningGoal": "Назначить столбцу понятный псевдоним через AS.",
      "difficultyLevel": 1,
      "publicationStatus": "Published",
      "hints": ["Псевдоним задаётся конструкцией AS customer_name."],
      "referenceQuery": {
        "sqlText": "SELECT full_name AS customer_name, city FROM customers ORDER BY id;",
        "strictColumnOrder": true,
        "strictRowOrder": true,
        "expectedResult": {
          "columns": ["customer_name", "city"],
          "rows": [["Анна", "Москва"], ["Борис", "Казань"], ["Вера", "Москва"], ["Глеб", null]]
        }
      }
    },
    {
      "id": "94000000-0000-0000-0000-000000000004",
      "topicId": "93000000-0000-0000-0000-000000000001",
      "targetDatabaseId": "92000000-0000-0000-0000-000000000001",
      "referenceQueryId": "95000000-0000-0000-0000-000000000004",
      "name": "Стоимость запасов",
      "text": "Для каждого товара вычислите price * stock и назовите столбец inventory_value. Выведите id и результат в порядке id.",
      "learningGoal": "Использовать арифметическое выражение в SELECT.",
      "difficultyLevel": 1,
      "publicationStatus": "Published",
      "hints": ["Умножьте price на stock прямо в списке SELECT."],
      "referenceQuery": {
        "sqlText": "SELECT id, price * stock AS inventory_value FROM products ORDER BY id;",
        "strictColumnOrder": true,
        "strictRowOrder": true,
        "expectedResult": {
          "columns": ["id", "inventory_value"],
          "rows": [["1", "450000.00"], ["2", "30000.00"], ["3", "75000.00"], ["4", "0.00"], ["5", "32000.00"], ["6", "72000.00"]]
        }
      }
    },
    {
      "id": "94000000-0000-0000-0000-000000000005",
      "topicId": "93000000-0000-0000-0000-000000000002",
      "targetDatabaseId": "92000000-0000-0000-0000-000000000001",
      "referenceQueryId": "95000000-0000-0000-0000-000000000005",
      "name": "Товары дороже 3000",
      "text": "Выведите название и цену товаров дороже 3000. Сортируйте сначала по цене, затем по id.",
      "learningGoal": "Отфильтровать строки числовым условием.",
      "difficultyLevel": 1,
      "publicationStatus": "Published",
      "hints": ["Условие задаётся после WHERE."],
      "referenceQuery": {
        "sqlText": "SELECT name, price FROM products WHERE price > 3000 ORDER BY price, id;",
        "strictColumnOrder": true,
        "strictRowOrder": true,
        "expectedResult": {
          "columns": ["name", "price"],
          "rows": [["Лампа", "4000.00"], ["Кресло", "18000.00"], ["Стол", "25000.00"], ["Ноутбук", "90000.00"]]
        }
      }
    },
    {
      "id": "94000000-0000-0000-0000-000000000006",
      "topicId": "93000000-0000-0000-0000-000000000002",
      "targetDatabaseId": "92000000-0000-0000-0000-000000000001",
      "referenceQueryId": "95000000-0000-0000-0000-000000000006",
      "name": "Активные клиенты Москвы",
      "text": "Выведите id и имя активных клиентов из Москвы в порядке id.",
      "learningGoal": "Соединить два условия оператором AND.",
      "difficultyLevel": 1,
      "publicationStatus": "Published",
      "hints": ["Проверьте одновременно city и is_active."],
      "referenceQuery": {
        "sqlText": "SELECT id, full_name FROM customers WHERE city = 'Москва' AND is_active = true ORDER BY id;",
        "strictColumnOrder": true,
        "strictRowOrder": true,
        "expectedResult": {
          "columns": ["id", "full_name"],
          "rows": [["1", "Анна"]]
        }
      }
    },
    {
      "id": "94000000-0000-0000-0000-000000000007",
      "topicId": "93000000-0000-0000-0000-000000000002",
      "targetDatabaseId": "92000000-0000-0000-0000-000000000001",
      "referenceQueryId": "95000000-0000-0000-0000-000000000007",
      "name": "Остаток от 1 до 10",
      "text": "Выведите id, название и остаток товаров, у которых stock от 1 до 10 включительно. Сортируйте по stock и id.",
      "learningGoal": "Использовать BETWEEN и составную сортировку.",
      "difficultyLevel": 2,
      "publicationStatus": "Published",
      "hints": ["BETWEEN включает обе границы."],
