{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SeedSmokeData": false,
  "CourseSeed": {
    "Enabled": false,
    "FilePath": "../IntegrationTests/TestData/basic-sql-course.json"
  },
  "ConnectionStrings": {
    "ConnectionString": "Host=localhost;Port=5433;Database=sqlmodule;Username=sqlmodule;Password=sqlmodule"
  },
  "DevTools": {
    "Enabled": false
  },
  "Auth": {
    "Authority": "http://localhost:5101",
    "Audience": "scoodle-api"
  },
  "ModuleIntegration": {
    "Enabled": false,
    "ServiceKey": "",
    "EducationBaseUrl": "",
    "Kafka": {
      "BootstrapServers": "",
      "EventsTopic": "scoodle.practice.events"
    }
  },
  "Sandbox": {
    "ComparisonMaxRows": 10000,
    "Pool": {
      "Enabled": false,
      "AcquireTimeoutSeconds": 15,
      "PreparationTimeoutSeconds": 30,
      "CleanupTimeoutSeconds": 15,
      "ShutdownTimeoutSeconds": 30,
      "HealthCheckIntervalSeconds": 15,
      "RestartBackoffMaxSeconds": 60,
      "Resources": {
        "MemoryLimitMegabytes": 512,
        "CpuLimit": 1.0,
        "PidsLimit": 256
      },
      "Profiles": {
        "postgres": {
          "MinSize": 1,
          "MaxSize": 2
        },
        "mysql": {
          "MinSize": 0,
          "MaxSize": 1
        }
      }
    }
  },
  "AttemptResultSnapshots": {
    "RetentionDays": 30,
    "MaxRows": 200,
    "MaxColumns": 100,
    "MaxCellLength": 16384,
    "MaxSerializedBytes": 1048576
  }
}
