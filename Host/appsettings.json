{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SeedSmokeData": false,
  "CourseSeed": {
    "Enabled": false,
    "FilePath": "../IntegrationTests/TestData/basic-sql-course.json"
  },
  "ConnectionStrings": {
    "ConnectionString": "Host=localhost;Port=5433;Database=sqlmodule;Username=sqlmodule;Password=sqlmodule"
  },
  "DevTools": {
    "Enabled": false
  },
  "Auth": {
